rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada quien lee/escribe sus propios datos (users/{uid}/...) — y ahora también
    // puede leer/escribir los datos de OTRO uid si está en su lista de miembros
    // (users/{uid}/members/{miUid} existe). Esto es lo que permite compartir un
    // inventario entre varias cuentas sin que nadie de afuera pueda entrar.
    //
    // A propósito se lista cada subcolección real (en vez de un solo
    // users/{uid}/{document=**} que las cubra todas de una) para que esta regla
    // NUNCA alcance a users/{uid}/members/{memberId}, más abajo. Firestore combina
    // con OR las reglas que matchean un mismo camino — no "la más específica gana" —
    // así que un wildcard de acá arriba haría inútil cualquier restricción puesta en
    // la regla de members: antes, CUALQUIER miembro del equipo podía borrar o editar
    // la membresía de OTRO miembro (ej. sacarlo del equipo) aunque la regla de más
    // abajo intentaba impedirlo explícitamente.
    match /users/{uid}/inventory/{document=**} {
      allow read, create, update, delete: if request.auth != null && (
        request.auth.uid == uid ||
        exists(/databases/$(database)/documents/users/$(uid)/members/$(request.auth.uid))
      );
    }
    match /users/{uid}/purchases/{document=**} {
      allow read, create, update, delete: if request.auth != null && (
        request.auth.uid == uid ||
        exists(/databases/$(database)/documents/users/$(uid)/members/$(request.auth.uid))
      );
    }
    match /users/{uid}/receipts/{document=**} {
      allow read, create, update, delete: if request.auth != null && (
        request.auth.uid == uid ||
        exists(/databases/$(database)/documents/users/$(uid)/members/$(request.auth.uid))
      );
    }
    // En meta/ viven settings, joined y team (los escribe el cliente) — y también
    // "billing" (plan y contador de escaneos), que escribe ÚNICAMENTE el Admin SDK
    // desde las Netlify functions (el Admin SDK saltea estas reglas). El wildcard
    // de antes dejaba que cualquier cuenta se escribiera a sí misma plan:"equipo"
    // y multiplicara su cupo de escaneos gratis — y como las reglas se combinan
    // con OR (ver el comentario largo de arriba), una regla "más específica" para
    // billing no podía revocarlo: la exclusión tiene que vivir en ESTA condición.
    // Leer billing sí se permite (una futura pantalla de "tu plan" lo necesita).
    match /users/{uid}/meta/{doc} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        exists(/databases/$(database)/documents/users/$(uid)/members/$(request.auth.uid))
      );
      // Los miembros solo escriben 'settings' (el doc grande de datos compartidos:
      // inventario-meta, notas, recetas...). 'team' (el código de invitación) y
      // 'joined' son del dueño: con el write abierto, un miembro podía pisar
      // meta/team.inviteCode con un código PROPIO — y cada futuro invitado del
      // dueño se unía en silencio al inventario del atacante — o plantarle un
      // meta/joined que le rompía el sync al próximo login.
      allow create, update, delete: if doc != 'billing' && request.auth != null && (
        request.auth.uid == uid ||
        (doc == 'settings' && exists(/databases/$(database)/documents/users/$(uid)/members/$(request.auth.uid)))
      );
    }
    match /users/{uid}/activity/{document=**} {
      allow read, create, update, delete: if request.auth != null && (
        request.auth.uid == uid ||
        exists(/databases/$(database)/documents/users/$(uid)/members/$(request.auth.uid))
      );
    }

    // El documento de membresía de cada persona lo controla ELLA MISMA (para poder
    // unirse o irse) — el dueño también puede leerlos y borrarlos (para sacar a
    // alguien del equipo), pero NINGÚN miembro puede tocar la membresía de otro.
    match /users/{uid}/members/{memberId} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.uid == memberId);

      // UNIRSE a un equipo exige PROBAR que se conoce un código de invitación válido de
      // ESTE dueño — no alcanza con que memberId sea uno mismo. El documento de membresía
      // que se crea debe traer el campo `code`, y ese código (en inviteCodes/) debe
      // pertenecer justamente a `uid`. Antes esta regla solo pedía `request.auth.uid ==
      // memberId`, así que CUALQUIER cuenta podía auto-agregarse al equipo de cualquier
      // otra con solo conocer su uid (que se filtra por la lectura abierta de inviteCodes),
      // ganando lectura/escritura total de su inventario, recibos y fotos — y un miembro
      // expulsado podía volver a agregarse al instante. El código es el secreto que la UI
      // ya pedía; ahora la regla lo hace obligatorio de verdad.
      allow create: if request.auth != null
        && request.auth.uid == memberId
        && request.resource.data.code is string
        && exists(/databases/$(database)/documents/inviteCodes/$(request.resource.data.code))
        && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.code)).data.ownerUid == uid;

      // El latido de presencia (lastActive, ver sendPresenceHeartbeat) actualiza la PROPIA
      // membresía YA existente con un merge — no vale re-pedir el código en cada latido, y
      // como es un update sobre un doc que ya existe, no puede usarse para "entrar" (eso
      // siempre pasa por create, de arriba). Si al miembro ya lo expulsaron, su doc dejó de
      // existir y este merge se convierte en un create → cae en la regla de arriba y queda
      // bloqueado: por fin la expulsión no se puede deshacer sola.
      // hasOnly + topes (auditoría 2026-09-04): sin esto, un miembro podía escribir
      // cualquier campo/tamaño en su doc de membresía — spoofear el email que ve el
      // dueño o inflar el doc. Los campos son los que escriben el join y el latido.
      allow update: if request.auth != null && request.auth.uid == memberId
        && request.resource.data.keys().hasOnly(['email','code','joinedAt','lastActive'])
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 200))
        && (!('code' in request.resource.data) || (request.resource.data.code is string && request.resource.data.code.size() <= 12))
        && (!('joinedAt' in request.resource.data) || (request.resource.data.joinedAt is string && request.resource.data.joinedAt.size() <= 40))
        && (!('lastActive' in request.resource.data) || (request.resource.data.lastActive is string && request.resource.data.lastActive.size() <= 40));

      allow delete: if request.auth != null && (request.auth.uid == uid || request.auth.uid == memberId);
    }

    // inviteCodes es la única forma de que alguien, sabiendo un código, encuentre a
    // qué uid pertenece para poder unirse. La lectura de UN documento queda abierta
    // a CUALQUIERA, sin sesión iniciada — a propósito: alguien que recién recibió un
    // código de invitación (flujo de nombre+PIN) todavía no tiene cuenta en ese
    // momento, así que exigir sesión acá bloquearía ese flujo por completo. La
    // privacidad depende de que haga falta saber el código exacto (1 en ~1000
    // millones de combinaciones), y eso solo es verdad con `get`: un `allow read`
    // también habilita `list`, o sea descargar la colección ENTERA de una — con los
    // ownerUid/ownerEmail de todos los equipos — y con cualquier código cosechado
    // así, unirse al equipo que sea (la regla de create de members valida contra
    // estos mismos docs). El cliente nunca lista esta colección (solo hace
    // .doc(code).get()), así que cerrar `list` no rompe ningún flujo.
    match /inviteCodes/{code} {
      allow get: if true;
      allow list: if false;
      // Formato fijo (6 caracteres, los campos exactos que escribe ensureInviteCode
      // y nada más) — sin esto, cualquier cuenta podía sembrar docs arbitrarios de
      // cualquier largo y cantidad en la colección (spam/squatting de códigos).
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && code.size() == 6
        && request.resource.data.keys().hasOnly(['ownerUid','ownerEmail'])
        && (!('ownerEmail' in request.resource.data) || (request.resource.data.ownerEmail is string && request.resource.data.ownerEmail.size() <= 200));
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Campos exactos y tamaño acotado: cualquier sesión (trial anónimo incluido)
    // puede crear docs acá, y sin tope cada una podía sembrar documentos de ~1MB
    // ilimitados (costo de Firestore puro). Los campos son los que escribe
    // sendFeedback() / reportClientError() y nada más.
    match /feedback/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid','email','name','message','userAgent','createdAt'])
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 4000
        && (!('uid' in request.resource.data) || (request.resource.data.uid is string && request.resource.data.uid.size() <= 128))
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 200))
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 200))
        && (!('userAgent' in request.resource.data) || (request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 500))
        && (!('createdAt' in request.resource.data) || (request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40));
      allow read, update, delete: if false;
    }

    // Reportes automáticos de errores del cliente (ver reportClientError() en
    // index.html) — mismo criterio que feedback: cualquier cuenta logueada puede
    // crear el suyo, nadie puede leer/editar/borrar por acá (el dueño los revisa
    // directo desde la consola de Firebase, con permisos de administrador, no a
    // través de la app).
    match /errorLogs/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['message','stack','source','uid','joinedOwnerUid','activeTab','uiLang','userAgent','createdAt'])
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 600
        && request.resource.data.stack is string
        && request.resource.data.stack.size() <= 2500
        && (!('source' in request.resource.data) || (request.resource.data.source is string && request.resource.data.source.size() <= 100))
        && (!('uid' in request.resource.data) || (request.resource.data.uid is string && request.resource.data.uid.size() <= 128))
        && (!('joinedOwnerUid' in request.resource.data) || (request.resource.data.joinedOwnerUid is string && request.resource.data.joinedOwnerUid.size() <= 128))
        && (!('activeTab' in request.resource.data) || (request.resource.data.activeTab is string && request.resource.data.activeTab.size() <= 40))
        && (!('uiLang' in request.resource.data) || (request.resource.data.uiLang is string && request.resource.data.uiLang.size() <= 10))
        && (!('userAgent' in request.resource.data) || (request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 500))
        && (!('createdAt' in request.resource.data) || (request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40));
      allow read, update, delete: if false;
    }
  }
}
