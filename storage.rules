rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Mismo criterio que firestore.rules: el dueño del inventario, o cualquier
    // persona en su lista de miembros (equipo compartido), puede leer/escribir
    // las fotos de sus recibos. firestore.exists() consulta la misma subcolección
    // users/{ownerUid}/members/{memberId} que ya usan las reglas de Firestore —
    // no hay una segunda fuente de verdad para quién pertenece a qué equipo.
    match /users/{ownerUid}/receipts/{allPaths=**} {
      allow read: if request.auth != null && (
        request.auth.uid == ownerUid ||
        firestore.exists(/databases/(default)/documents/users/$(ownerUid)/members/$(request.auth.uid))
      );
      // Subidas acotadas: solo imágenes y hasta 10MB por archivo — sin esto,
      // cualquier miembro podía usar el bucket del dueño como disco gratis con
      // archivos arbitrarios de cualquier tamaño (costo de Storage puro). El
      // create/update se separa del delete porque en un delete request.resource
      // es null y las condiciones de tamaño/tipo lo bloquearían.
      allow create, update: if request.auth != null && (
        request.auth.uid == ownerUid ||
        firestore.exists(/databases/(default)/documents/users/$(ownerUid)/members/$(request.auth.uid))
      ) && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && (
        request.auth.uid == ownerUid ||
        firestore.exists(/databases/(default)/documents/users/$(ownerUid)/members/$(request.auth.uid))
      );
    }
    // Fotos del catálogo en ALTA (las sube upload-catalog-photo con el Admin
    // SDK y quedan públicas por ACL para la página del catálogo). Esta lectura
    // por el SDK es para "Compartir foto" desde la app (auditoría 2026-09-07):
    // la URL pública de storage.googleapis.com no manda cabeceras CORS, así que
    // un fetch() desde la app no puede leerla — la URL de descarga de Firebase
    // sí. Solo lectura, para el dueño o su equipo; nadie escribe por acá.
    match /catalogHires/{ownerUid}/{allPaths=**} {
      allow read: if request.auth != null && (
        request.auth.uid == ownerUid ||
        firestore.exists(/databases/(default)/documents/users/$(ownerUid)/members/$(request.auth.uid))
      );
    }
    // Fotos de recetas: mismas condiciones que las de recibos (dueño o miembro del
    // equipo; subidas solo de imágenes y acotadas).
    match /users/{ownerUid}/recipes/{allPaths=**} {
      allow read: if request.auth != null && (
        request.auth.uid == ownerUid ||
        firestore.exists(/databases/(default)/documents/users/$(ownerUid)/members/$(request.auth.uid))
      );
      allow create, update: if request.auth != null && (
        request.auth.uid == ownerUid ||
        firestore.exists(/databases/(default)/documents/users/$(ownerUid)/members/$(request.auth.uid))
      ) && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && (
        request.auth.uid == ownerUid ||
        firestore.exists(/databases/(default)/documents/users/$(ownerUid)/members/$(request.auth.uid))
      );
    }
  }
}
